rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(code) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/trips/$(code)).data.members;
    }

    match /trips/{code} {
      // The 10-character trip code is the invite secret: anyone signed in who
      // knows it can read the trip (needed to join).
      allow get: if signedIn();
      // "My trips" list query must filter on members array-contains uid.
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.code == code
        && request.resource.data.members == [request.auth.uid];
      // Members can edit the trip but not remove other members.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.code == resource.data.code;
      // Non-members can only add themselves to members (joining).
      allow update: if signedIn() && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid])
        && request.resource.data.members.hasAll(resource.data.members);
      allow delete: if false;

      match /expenses/{id} {
        allow read: if isMember(code);
        allow create: if isMember(code) && request.resource.data.id == id;
        // Authorship can't be rewritten; deletes are soft (deleted: true).
        allow update: if isMember(code)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.id == resource.data.id;
        allow delete: if false;
      }
    }
  }
}
