rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function trip(code) {
      return get(/databases/$(database)/documents/trips/$(code)).data;
    }
    function isMember(code) {
      return signedIn() && request.auth.uid in trip(code).members;
    }
    // The person this device picked in "Which one is you?".
    function myPerson(code) {
      return trip(code).get('memberPeople', {}).get(request.auth.uid, null);
    }

    match /trips/{code} {
      // The 10-character trip code is the invite secret: anyone signed in who
      // knows it can read the trip (needed to join).
      allow get: if signedIn();
      // "My trips" list query must filter on members array-contains uid.
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.code == code
        && request.resource.data.members == [request.auth.uid];
      // Members can edit the trip but not remove other members, and can only
      // change their own device's entry in memberPeople.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.code == resource.data.code
        && request.resource.data.get('memberPeople', {}).diff(resource.data.get('memberPeople', {}))
             .affectedKeys().hasOnly([request.auth.uid]);
      // Non-members can only add themselves to members (joining).
      allow update: if signedIn() && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid])
        && request.resource.data.members.hasAll(resource.data.members);
      allow delete: if false;

      match /receipts/{id} {
        allow read: if isMember(code);
        // Only an inline image may be stored: the app renders dataUrl as a link
        // and <img>, so an http(s) or script URL here would reach other members.
        allow create, update: if isMember(code)
          && request.resource.data.keys().hasOnly(['id', 'dataUrl', 'createdBy', 'createdAt'])
          && request.resource.data.id == id
          && request.resource.data.createdBy == myPerson(code)
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() < 900000
          && request.resource.data.dataUrl.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+');
        allow delete: if false;
      }

      match /expenses/{id} {
        allow read: if isMember(code);
        // createdBy/updatedBy/deletedBy must name the writer's own person, so
        // "added by" and "edited by" can't be attributed to someone else.
        allow create: if isMember(code) && request.resource.data.id == id
          && request.resource.data.createdBy == myPerson(code)
          && request.resource.data.updatedBy == myPerson(code)
          && request.resource.data.get('deletedBy', null) in [null, myPerson(code)];
        // Authorship can't be rewritten; deletes are soft (deleted: true).
        // Any device may fill in a rate that was pending without becoming the editor.
        allow update: if isMember(code)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.id == resource.data.id
          && (
            (request.resource.data.updatedBy == myPerson(code)
              && request.resource.data.get('deletedBy', null)
                   in [null, myPerson(code), resource.data.get('deletedBy', null)])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rateToBase', 'rateSource'])
          );
        allow delete: if false;
      }
    }
  }
}
